{
	"name": "demchukdenys",
	"version": "0.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"test": "ng test"
	},
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			},
			{
				"files": "*.css",
				"options": {
					"parser": "css"
				}
			},
			{
				"files": "*.ts",
				"options": {
					"parser": "typescript"
				}
			},
			{
				"files": "*.json",
				"options": {
					"parser": "json"
				}
			}
		]
	},
	"private": true,
	"packageManager": "npm@11.6.2",
	"dependencies": {
		"@angular/common": "22.1.0",
		"@angular/compiler": "22.1.0",
		"@angular/core": "22.1.0",
		"@angular/forms": "22.1.0",
		"@angular/platform-browser": "22.1.0",
		"@angular/platform-server": "22.1.0",
		"@angular/router": "22.1.0",
		"@angular/ssr": "22.1.2",
		"rxjs": "7.8.2",
		"tslib": "2.8.1"
	},
	"devDependencies": {
		"@angular/build": "22.1.2",
		"@angular/cli": "22.1.2",
		"@angular/compiler-cli": "22.1.0",
		"@tailwindcss/postcss": "4.3.1",
		"@types/node": "24.12.4",
		"jsdom": "29.1.1",
		"postcss": "8.5.15",
		"prettier": "3.8.4",
		"tailwindcss": "4.3.1",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	}
}
